<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <RootNamespace>Tenon.Cli</RootNamespace>
    <AssemblyName>tenon</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tenon</ToolCommandName>
    <PackageId>tenon</PackageId>
    <Description>Tenon: build MSI installers and a modern Setup.exe for .NET desktop apps from one tenon.json.</Description>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <!-- Prebuilt per-architecture assets travel inside the tool package under stub/<rid>/ (see build/publish-assets.ps1). -->
  <ItemGroup>
    <None Include="..\Tenon.Setup\bin\stub\win-*\tenon-setup.exe" Pack="true" PackagePath="tools\net8.0\any\stub" Visible="false" />
    <None Include="..\Tenon.CustomAction\bin\native\win-*\TenonCA.dll" Pack="true" PackagePath="tools\net8.0\any\stub" Visible="false" />
    <None Include="..\Tenon.HookHost\bin\host\win-*\tenon-hookhost.exe" Pack="true" PackagePath="tools\net8.0\any\stub" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tenon.Core\Tenon.Core.csproj" />
    <ProjectReference Include="..\Tenon.Msi\Tenon.Msi.csproj" />
    <ProjectReference Include="..\Tenon.Cab\Tenon.Cab.csproj" />
    <ProjectReference Include="..\Tenon.Native\Tenon.Native.csproj" />
    <ProjectReference Include="..\Tenon.Payload\Tenon.Payload.csproj" />
    <ProjectReference Include="..\Tenon.Update\Tenon.Update.csproj" />
  </ItemGroup>
</Project>
