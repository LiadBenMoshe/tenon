<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Tenon.Setup</RootNamespace>
    <AssemblyName>tenon-setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>setup.ico</ApplicationIcon>
    <Description>Tenon setup bootstrapper stub. tenon build appends the product payload to this executable.</Description>
    <IsPackable>false</IsPackable>
    <!-- Published once by the Tenon build as a self-contained single file; the CLI appends payloads to it. -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tenon.Payload\Tenon.Payload.csproj" />
    <ProjectReference Include="..\Tenon.Native\Tenon.Native.csproj" />
  </ItemGroup>
</Project>
