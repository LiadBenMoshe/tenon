<Window x:Class="Tenon.Setup.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Tenon.Setup.Ui"
        Title="{Binding WindowTitle}" Width="680" Height="480" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="{DynamicResource SetupFontFamily}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ui:BoolToVisibilityConverter x:Key="Vis" />
        <ui:BoolToVisibilityConverter x:Key="VisInverted" Invert="True" />
        <ui:NullToVisibilityConverter x:Key="NotNullVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Text="{Binding WindowTitle}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                    <Path Data="M0,0 L10,0" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1" />
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"
                        IsEnabled="{Binding IsBusy, Converter={x:Static ui:MainWindow.Not}}">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- side panel -->
            <Border Grid.Column="0" Background="{DynamicResource SidePanelBrush}">
                <StackPanel Margin="24,28,20,24">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#33FFFFFF" HorizontalAlignment="Left">
                        <Image x:Name="Logo" Width="40" Height="40" />
                    </Border>
                    <TextBlock Text="{Binding ProductName}" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,2" />
                    <TextBlock Text="{Binding Version}" Foreground="#CCFFFFFF" FontSize="12" />
                    <TextBlock Text="{Binding Description}" Foreground="#B3FFFFFF" FontSize="12" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding Publisher}" Foreground="#99FFFFFF" FontSize="11" Margin="0,24,0,0" VerticalAlignment="Bottom" />
                </StackPanel>
            </Border>

            <!-- page content -->
            <Grid Grid.Column="1" Margin="32,28,32,16" Background="{DynamicResource ContentBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

                <!-- welcome -->
                <StackPanel Grid.Row="2" Visibility="{Binding IsWelcome, Converter={StaticResource Vis}}">
                    <TextBlock Text="Click Next to continue, or Cancel to exit Setup." Style="{StaticResource Muted}" />
                </StackPanel>

                <!-- maintenance -->
                <StackPanel Grid.Row="2" Visibility="{Binding IsMaintenance, Converter={StaticResource Vis}}">
                    <Button Content="Repair" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" MinWidth="160" Height="38"
                            Command="{Binding RepairCommand}" Visibility="{Binding CanRepair, Converter={StaticResource Vis}}" />
                    <Button Content="Uninstall" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0" MinWidth="160" Height="38"
                            Command="{Binding UninstallCommand}" />
                    <CheckBox Content="Also delete my settings and data" IsChecked="{Binding DeleteAppData}" Margin="0,14,0,0"
                              Visibility="{Binding CanDeleteAppData, Converter={StaticResource Vis}}" />
                    <TextBlock Text="Repair reinstalls missing or damaged files. Uninstall removes the application; your documents are kept."
                               Style="{StaticResource Muted}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding ElevationNote}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding ElevationNote, Converter={StaticResource NotNullVis}}" />
                </StackPanel>

                <!-- license -->
                <Grid Grid.Row="2" Visibility="{Binding IsLicense, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RichTextBox x:Name="LicenseBox" Grid.Row="0" FontSize="12" />
                    <CheckBox Grid.Row="1" Content="I accept the terms of the license agreement" IsChecked="{Binding LicenseAccepted}" Margin="0,12,0,0" />
                </Grid>

                <!-- folder -->
                <StackPanel Grid.Row="2" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}">
                    <StackPanel Visibility="{Binding CanChooseScope, Converter={StaticResource Vis}}" Margin="0,0,0,16">
                        <TextBlock Text="Install for" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <RadioButton Content="Only me (no administrator permission needed)" IsChecked="{Binding PerUser}" GroupName="Scope" />
                        <RadioButton Content="All users of this computer" IsChecked="{Binding PerMachine}" GroupName="Scope" />
                        <TextBlock Text="{Binding ScopeNote}" Style="{StaticResource Muted}" Margin="22,2,0,0" Visibility="{Binding ScopeNote, Converter={StaticResource NotNullVis}}" />
                    </StackPanel>
                    <TextBlock Text="Destination folder" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InstallDir, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AllowChangeDir}" />
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}" IsEnabled="{Binding AllowChangeDir}" />
                    </Grid>
                    <TextBlock Text="{Binding SpaceInfo}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                </StackPanel>

                <!-- options -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOptions, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="22,0,0,0"
                                               Visibility="{Binding Description, Converter={StaticResource NotNullVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- progress -->
                <StackPanel Grid.Row="2" Visibility="{Binding IsProgress, Converter={StaticResource Vis}}" VerticalAlignment="Top" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- finish -->
                <StackPanel Grid.Row="2" Visibility="{Binding IsFinish, Converter={StaticResource Vis}}">
                    <CheckBox Content="{Binding LaunchText}" IsChecked="{Binding LaunchApp}"
                              Visibility="{Binding CanLaunch, Converter={StaticResource Vis}}" />
                    <TextBlock Text="You need to restart your computer before the changes take effect." Style="{StaticResource Muted}"
                               Visibility="{Binding RebootRequired, Converter={StaticResource Vis}}" />
                </StackPanel>

                <!-- error -->
                <StackPanel Grid.Row="2" Visibility="{Binding IsError, Converter={StaticResource Vis}}">
                    <Border Background="{DynamicResource ControlHoverBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ErrorMessage}" />
                    </Border>
                    <TextBlock Text="{Binding ErrorHint}" Style="{StaticResource Muted}" Visibility="{Binding ErrorHint, Converter={StaticResource NotNullVis}}" Margin="0,0,0,8" />
                    <TextBlock>
                        <Hyperlink Command="{Binding OpenLogCommand}">Open the setup log</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- footer -->
        <Border Grid.Row="2" Background="{DynamicResource FooterBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}">
                    <Hyperlink Command="{Binding OpenLogCommand}">View log</Hyperlink>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Visibility="{Binding ShowBack, Converter={StaticResource Vis}}" />
                    <Button Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" IsDefault="True"
                            Visibility="{Binding ShowNext, Converter={StaticResource Vis}}" />
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" IsCancel="True"
                            Visibility="{Binding ShowCancel, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
