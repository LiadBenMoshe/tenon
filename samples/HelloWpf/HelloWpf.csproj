<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Tenon Samples</Company>
    <Product>Hello Tenon</Product>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;.tenon\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Real projects reference the Tenon.Update NuGet package. -->
    <ProjectReference Include="..\..\src\Tenon.Update\Tenon.Update.csproj" />
  </ItemGroup>
</Project>
